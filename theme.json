{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "dimensions": {
      "defaultAspectRatios": true,
      "minHeight": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "card",
          "shadow": "0 4px 16px rgba(34, 61, 46, 0.08)",
          "name": "Card"
        },
        {
          "slug": "hover",
          "shadow": "0 8px 24px rgba(34, 61, 46, 0.14)",
          "name": "Hover"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1440px",
      "allowCustomContentAndWideSize": false
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "padding": ["top", "bottom"],
      "margin": ["top", "bottom"],
      "blockGap": true,
      "spacingSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "clamp(0.5rem, 0.4286rem + 0.3571vw, 0.75rem)"
        },
        {
          "slug": "s",
          "name": "S",
          "size": "clamp(0.75rem, 0.6429rem + 0.5357vw, 1.125rem)"
        },
        {
          "slug": "m",
          "name": "M",
          "size": "clamp(1.25rem, 1.0714rem + 0.8929vw, 1.875rem)"
        },
        {
          "slug": "l",
          "name": "L",
          "size": "clamp(2rem, 1.7143rem + 1.4286vw, 3rem)"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "clamp(3rem, 2.4286rem + 2.8571vw, 5rem)"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "clamp(4rem, 3.1429rem + 4.2857vw, 7rem)"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "clamp(6rem, 4.8571rem + 5.7143vw, 10rem)"
        },
        {
          "slug": "space-xs",
          "name": "Space XS",
          "size": "8px"
        },
        {
          "slug": "space-sm",
          "name": "Space SM",
          "size": "16px"
        },
        {
          "slug": "space-md",
          "name": "Space MD",
          "size": "24px"
        },
        {
          "slug": "space-lg",
          "name": "Space LG",
          "size": "48px"
        },
        {
          "slug": "space-xl",
          "name": "Space XL",
          "size": "96px"
        },
        {
          "slug": "space-2xl",
          "name": "Space 2XL",
          "size": "128px"
        }
      ]
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultGradients": false,
      "gradients": [],
      "defaultPalette": false,
      "palette": [
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "light",
          "color": "#f5f5f5",
          "name": "Light"
        },
        {
          "slug": "primary",
          "color": "#223D2E",
          "name": "Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#1A2F23",
          "name": "Primary dark"
        },
        {
          "slug": "accent",
          "color": "#B16B3A",
          "name": "Accent"
        },
        {
          "slug": "accent-dark",
          "color": "#8F5228",
          "name": "Accent dark"
        },
        {
          "slug": "bg-base",
          "color": "#FAF8F5",
          "name": "Background base"
        },
        {
          "slug": "bg-surface",
          "color": "#FFFFFF",
          "name": "Background surface"
        },
        {
          "slug": "text-primary",
          "color": "#223D2E",
          "name": "Text primary"
        },
        {
          "slug": "text-secondary",
          "color": "#5C6B62",
          "name": "Text secondary"
        },
        {
          "slug": "border",
          "color": "#E4DFD8",
          "name": "Border"
        },
        {
          "slug": "success",
          "color": "#4A7A5E",
          "name": "Success"
        },
        {
          "slug": "error",
          "color": "#B4483C",
          "name": "Error"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "fontStyle": false,
      "fontWeight": false,
      "lineHeight": false,
      "letterSpacing": false,
      "textDecoration": false,
      "textTransform": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "main",
          "fontFamily": "'Mona Sans', -apple-system, 'BlinkMacSystemFont', 'Segoe UI', 'Helvetica', 'Arial', sans-serif",
          "name": "Mona Sans",
          "fontFace": [
            {
              "fontFamily": "Mona Sans",
              "fontWeight": "1 999",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/monasansvf.woff2"]
            }
          ]
        },
        {
          "slug": "display",
          "fontFamily": "'Manrope', sans-serif",
          "name": "Manrope",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "200",
              "fontStyle": "normal",
